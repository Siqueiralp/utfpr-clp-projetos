// Requer FB107 do Projeto 7 ja compilado no mesmo S7 Program.
FUNCTION_BLOCK FB108
TITLE = 'Projetos 8 e 9 - semaforo de 13 lampadas'
VAR_INPUT
    Maceio : BOOL;               // FALSE: Sao Jose; TRUE: Maceio
    TempoVermelho : S5TIME;
    TempoVerde : S5TIME;
    TempoAmarelo : S5TIME;
    TempoDeslocamento : S5TIME;
END_VAR
VAR
    vermelhos : FB107;
    verdes : FB107;
    fase : INT := 0;
    novoGrupo : BOOL := TRUE;
    pronto : BOOL := FALSE;
    alto : BOOL := FALSE;
    semeados : INT := 0;
    deslocados : INT := 0;
    armaTempo : BOOL := FALSE;
END_VAR
VAR_TEMP
    resetR : BOOL;
    resetG : BOOL;
    pulsoR : BOOL;
    pulsoG : BOOL;
    dadoR : BOOL;
    dadoG : BOOL;
    alvo : INT;
    limite : INT;
    fimTempo : BOOL;
    duracao : S5TIME;
    restante : WORD;
    resultado : S5TIME;
END_VAR
BEGIN
    resetR := FALSE; resetG := FALSE;
    pulsoR := FALSE; pulsoG := FALSE;
    dadoR := FALSE; dadoG := FALSE;

    IF Maceio THEN
        alvo := 6;
        limite := 6;
    ELSE
        alvo := 1;
        limite := 5;
    END_IF;

    // Prepara o registrador usando o mesmo FB107 do Projeto 7.
    IF novoGrupo THEN
        IF fase = 0 THEN resetR := TRUE; ELSE resetG := TRUE; END_IF;
        semeados := 0;
        deslocados := 0;
        alto := FALSE;
        pronto := FALSE;
        novoGrupo := FALSE;
    ELSIF ((fase = 0) OR (fase = 3)) AND NOT pronto THEN
        IF NOT alto THEN
            alto := TRUE;
            semeados := semeados + 1;
            IF fase = 0 THEN pulsoR := TRUE; dadoR := TRUE;
            ELSE pulsoG := TRUE; dadoG := TRUE; END_IF;
        ELSE
            alto := FALSE;
            IF semeados >= alvo THEN pronto := TRUE; END_IF;
        END_IF;
    END_IF;

    IF fase = 0 THEN duracao := TempoVermelho;
    ELSIF fase = 3 THEN duracao := TempoVerde;
    ELSIF (fase = 2) OR (fase = 5) THEN duracao := TempoAmarelo;
    ELSE duracao := TempoDeslocamento;
    END_IF;

    resultado := S_ODT(T_NO := T80, S := armaTempo AND pronto,
                       TV := duracao, R := FALSE,
                       BI := restante, Q := fimTempo);

    IF pronto THEN
        IF fimTempo THEN
            armaTempo := FALSE;
            CASE fase OF
                0: fase := 1;
                1:
                    IF deslocados < limite THEN
                        pulsoR := TRUE;
                        deslocados := deslocados + 1;
                    ELSE
                        fase := 2;
                    END_IF;
                2:
                    fase := 3;
                    novoGrupo := TRUE;
                    pronto := FALSE;
                3: fase := 4;
                4:
                    IF deslocados < limite THEN
                        pulsoG := TRUE;
                        deslocados := deslocados + 1;
                    ELSE
                        fase := 5;
                    END_IF;
                5:
                    fase := 0;
                    novoGrupo := TRUE;
                    pronto := FALSE;
            ELSE
                fase := 0;
                novoGrupo := TRUE;
                pronto := FALSE;
            END_CASE;
        ELSIF NOT armaTempo THEN
            armaTempo := TRUE;
        END_IF;
    END_IF;

    IF (fase = 2) OR (fase = 5) THEN pronto := TRUE; END_IF;

    vermelhos(Forwardpulse := pulsoR, Forwarddata := dadoR,
              Backwardpulse := FALSE, Backwarddata := FALSE, Reset := resetR);
    verdes(Forwardpulse := pulsoG, Forwarddata := dadoG,
           Backwardpulse := FALSE, Backwarddata := FALSE, Reset := resetG);

    // Escrita por BYTE substitui 13 atribuicoes BOOL por scan.
    QB0 := B#16#00;
    QB1 := B#16#00;

    IF (fase = 0) OR (fase = 1) THEN
        IF NOT pronto THEN
            IF Maceio THEN QB0 := B#16#3F;
            ELSE QB0 := B#16#01; END_IF;
        ELSE
            QB0 := vermelhos.Data AND B#16#3F;
        END_IF;
    ELSIF (fase = 3) OR (fase = 4) THEN
        IF NOT pronto THEN
            IF Maceio THEN QB1 := B#16#3F;
            ELSE QB1 := B#16#01; END_IF;
        ELSE
            QB1 := verdes.Data AND B#16#3F;
        END_IF;
    ELSE
        QB0 := B#16#40;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB108.DB108(Maceio := FALSE, TempoVermelho := T#30S,
                TempoVerde := T#30S, TempoAmarelo := T#4S,
                TempoDeslocamento := T#1S);
END_ORGANIZATION_BLOCK
