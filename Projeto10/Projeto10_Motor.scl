FUNCTION_BLOCK FB110
TITLE = 'Projeto 10 - quatro rampas de velocidade'
VAR
    etapa : INT := 7;              // 0/2 sobe; 4/6 desce; 1/3/5 patamar
    comando : INT := 0;
    esperaTicks : INT := 0;
    anteriorStart : BOOL := FALSE;
    armaTick : BOOL := FALSE;
    fimTick : BOOL := FALSE;
    tempo : S5TIME;
END_VAR
BEGIN
    IF I0.1 THEN
        etapa := 7; comando := 0;
    ELSIF I0.0 AND NOT anteriorStart AND (etapa = 7) THEN
        etapa := 0; comando := 0; esperaTicks := 0;
    END_IF;
    anteriorStart := I0.0;

    tempo := S_ODT(T_NO := T100, S := armaTick AND (etapa <> 7),
                   TV := T#100MS, R := (etapa = 7), Q := fimTick);
    IF etapa = 7 THEN
        armaTick := FALSE;
    ELSIF fimTick THEN
        armaTick := FALSE;
        CASE etapa OF
            0: comando := comando + 32;
               IF comando >= 2048 THEN comando := 2048;
                   etapa := 1; esperaTicks := 0; END_IF;
            1: esperaTicks := esperaTicks + 1;
               IF esperaTicks >= 30 THEN etapa := 2; END_IF;
            2: comando := comando + 128;
               IF comando >= 4095 THEN comando := 4095;
                   etapa := 3; esperaTicks := 0; END_IF;
            3: esperaTicks := esperaTicks + 1;
               IF esperaTicks >= 50 THEN etapa := 4; END_IF;
            4: comando := comando - 128;
               IF comando <= 2048 THEN comando := 2048;
                   etapa := 5; esperaTicks := 0; END_IF;
            5: esperaTicks := esperaTicks + 1;
               IF esperaTicks >= 30 THEN etapa := 6; END_IF;
            6: comando := comando - 32;
               IF comando <= 0 THEN comando := 0; etapa := 7; END_IF;
        END_CASE;
    ELSIF NOT armaTick THEN
        armaTick := TRUE;
    END_IF;

    MW100 := comando;              // observacao simples em PLCSIM
    PQW256 := INT_TO_WORD(comando); // ajustar endereco ao modulo analogico
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB110.DB110();
END_ORGANIZATION_BLOCK
