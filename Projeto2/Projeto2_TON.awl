ORGANIZATION_BLOCK OB 1
TITLE = "Projeto 2 - Semaforo LAD compacto com um TON"
VERSION : 0.3

VAR_TEMP
  OB1_EV_CLASS : BYTE ;
  OB1_SCAN_1 : BYTE ;
  OB1_PRIORITY : BYTE ;
  OB1_OB_NUMBR : BYTE ;
  OB1_RESERVED_1 : BYTE ;
  OB1_RESERVED_2 : BYTE ;
  OB1_PREV_CYCLE : INT ;
  OB1_MIN_CYCLE : INT ;
  OB1_MAX_CYCLE : INT ;
  OB1_DATE_TIME : DATE_AND_TIME ;
END_VAR

BEGIN

NETWORK
TITLE = "Inicializacao - estado 0"
      AN    M      0.3;
      L     0;
      T     MW    20;
      S     M      0.1;
      S     M      0.3;

NETWORK
TITLE = "Memoriza pedido de pedestre"
      A     I      0.0;
      FP    M      0.2;
      S     M      0.0;

NETWORK
TITLE = "Preset 30 s - estados 0 e 3"
      L     MW    20;
      L     0;
      ==I;
      O(
      L     MW    20;
      L     3;
      ==I;
      );
      JCN   P1A;
      L     S5T#30S;
      T     MW    22;
P1A:  NOP   0;

NETWORK
TITLE = "Preset 4 s - estados 1 e 4"
      L     MW    20;
      L     1;
      ==I;
      O(
      L     MW    20;
      L     4;
      ==I;
      );
      JCN   P1B;
      L     S5T#4S;
      T     MW    22;
P1B:  NOP   0;

NETWORK
TITLE = "Preset 2 s - estados 2 e 5"
      L     MW    20;
      L     2;
      ==I;
      O(
      L     MW    20;
      L     5;
      ==I;
      );
      JCN   P1C;
      L     S5T#2S;
      T     MW    22;
P1C:  NOP   0;

NETWORK
TITLE = "Preset 15 s - estados 6 e 8"
      L     MW    20;
      L     6;
      ==I;
      O(
      L     MW    20;
      L     8;
      ==I;
      );
      JCN   P1D;
      L     S5T#15S;
      T     MW    22;
P1D:  NOP   0;

NETWORK
TITLE = "Preset 5 s - estados 7 e 9"
      L     MW    20;
      L     7;
      ==I;
      O(
      L     MW    20;
      L     9;
      ==I;
      );
      JCN   P1E;
      L     S5T#5S;
      T     MW    22;
P1E:  NOP   0;

NETWORK
TITLE = "Unico TON"
      A     M      0.1;
      L     MW    22;
      SD    T      0;

NETWORK
TITLE = "Rearma TON apos um scan em zero"
      AN    M      0.1;
      AN    T      0;
      S     M      0.1;

NETWORK
TITLE = "9 -> 0"
      L     MW    20;
      L     9;
      ==I;
      A     T      0;
      JCN   T90;
      L     0;
      T     MW    20;
      R     M      0.1;
T90:  NOP   0;

NETWORK
TITLE = "8 -> 9"
      L     MW    20;
      L     8;
      ==I;
      A     T      0;
      JCN   T89;
      L     9;
      T     MW    20;
      R     M      0.1;
T89:  NOP   0;

NETWORK
TITLE = "7 -> 3"
      L     MW    20;
      L     7;
      ==I;
      A     T      0;
      JCN   T73;
      L     3;
      T     MW    20;
      R     M      0.1;
T73:  NOP   0;

NETWORK
TITLE = "6 -> 7"
      L     MW    20;
      L     6;
      ==I;
      A     T      0;
      JCN   T67;
      L     7;
      T     MW    20;
      R     M      0.1;
T67:  NOP   0;

NETWORK
TITLE = "5 -> 0 sem pedido"
      L     MW    20;
      L     5;
      ==I;
      A     T      0;
      AN    M      0.0;
      JCN   T50;
      L     0;
      T     MW    20;
      R     M      0.1;
T50:  NOP   0;

NETWORK
TITLE = "5 -> 8 com pedido"
      L     MW    20;
      L     5;
      ==I;
      A     T      0;
      A     M      0.0;
      JCN   T58;
      L     8;
      T     MW    20;
      R     M      0.0;
      R     M      0.1;
T58:  NOP   0;

NETWORK
TITLE = "4 -> 5 sem pedido"
      L     MW    20;
      L     4;
      ==I;
      A     T      0;
      AN    M      0.0;
      JCN   T45;
      L     5;
      T     MW    20;
      R     M      0.1;
T45:  NOP   0;

NETWORK
TITLE = "4 -> 8 com pedido"
      L     MW    20;
      L     4;
      ==I;
      A     T      0;
      A     M      0.0;
      JCN   T48;
      L     8;
      T     MW    20;
      R     M      0.0;
      R     M      0.1;
T48:  NOP   0;

NETWORK
TITLE = "3 -> 4"
      L     MW    20;
      L     3;
      ==I;
      A     T      0;
      JCN   T34;
      L     4;
      T     MW    20;
      R     M      0.1;
T34:  NOP   0;

NETWORK
TITLE = "2 -> 3 sem pedido"
      L     MW    20;
      L     2;
      ==I;
      A     T      0;
      AN    M      0.0;
      JCN   T23;
      L     3;
      T     MW    20;
      R     M      0.1;
T23:  NOP   0;

NETWORK
TITLE = "2 -> 6 com pedido"
      L     MW    20;
      L     2;
      ==I;
      A     T      0;
      A     M      0.0;
      JCN   T26;
      L     6;
      T     MW    20;
      R     M      0.0;
      R     M      0.1;
T26:  NOP   0;

NETWORK
TITLE = "1 -> 2 sem pedido"
      L     MW    20;
      L     1;
      ==I;
      A     T      0;
      AN    M      0.0;
      JCN   T12;
      L     2;
      T     MW    20;
      R     M      0.1;
T12:  NOP   0;

NETWORK
TITLE = "1 -> 6 com pedido"
      L     MW    20;
      L     1;
      ==I;
      A     T      0;
      A     M      0.0;
      JCN   T16;
      L     6;
      T     MW    20;
      R     M      0.0;
      R     M      0.1;
T16:  NOP   0;

NETWORK
TITLE = "0 -> 1"
      L     MW    20;
      L     0;
      ==I;
      A     T      0;
      JCN   T01;
      L     1;
      T     MW    20;
      R     M      0.1;
T01:  NOP   0;

NETWORK
TITLE = "Saida - Verde Via 1"
      L     MW    20;
      L     3;
      ==I;
      =     Q      0.0;

NETWORK
TITLE = "Saida - Amarelo Via 1"
      L     MW    20;
      L     4;
      ==I;
      =     Q      0.1;

NETWORK
TITLE = "Saida - Vermelho Via 1"
      L     MW    20;
      L     3;
      <>I;
      A(
      L     MW    20;
      L     4;
      <>I;
      );
