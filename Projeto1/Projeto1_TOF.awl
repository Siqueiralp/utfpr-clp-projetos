ORGANIZATION_BLOCK OB 1
TITLE = "Projeto 1 - Semaforo intuitivo com TOF"
VERSION : 0.1

VAR_TEMP
  OB1_EV_CLASS : BYTE ;
  OB1_SCAN_1 : BYTE ;
  OB1_PRIORITY : BYTE ;
  OB1_OB_NUMBR : BYTE ;
  OB1_RESERVED_1 : BYTE ;
  OB1_RESERVED_2 : BYTE ;
  OB1_PREV_CYCLE : INT ;
  OB1_MIN_CYCLE : INT ;
  OB1_MAX_CYCLE : INT ;
  OB1_DATE_TIME : DATE_AND_TIME ;
END_VAR

BEGIN

NETWORK
TITLE = "Inicializacao - ativa Etapa 1"
      AN    M      0.7;
      S     M      0.0;

NETWORK
TITLE = "Inicializacao - trava primeiro scan"
      AN    M      0.7;
      S     M      0.7;

NETWORK
TITLE = "Memoriza pedido de pedestre por borda"
      A     I      0.0;
      FP    M      3.2;
      S     M      0.6;

NETWORK
TITLE = "Etapa 1 - TOF 30 s"
      A     M      0.0;
      FP    M      2.0;
      L     S5T#30S;
      SF    T      0;

NETWORK
TITLE = "Etapa 1 para Etapa 2"
      A     M      0.0;
      AN    T      0;
      S     M      0.1;
      R     M      0.0;

NETWORK
TITLE = "Etapa 2 - TOF 4 s"
      A     M      0.1;
      FP    M      2.1;
      L     S5T#4S;
      SF    T      1;

NETWORK
TITLE = "Etapa 2 sem pedestre para Etapa 3"
      A     M      0.1;
      AN    T      1;
      AN    M      0.6;
      S     M      0.2;
      R     M      0.1;

NETWORK
TITLE = "Etapa 2 com pedestre"
      A     M      0.1;
      AN    T      1;
      A     M      0.6;
      S     M      1.0;
      S     M      1.2;
      R     M      0.6;
      R     M      0.1;

NETWORK
TITLE = "Etapa 3 - TOF 2 s"
      A     M      0.2;
      FP    M      2.2;
      L     S5T#2S;
      SF    T      2;

NETWORK
TITLE = "Etapa 3 sem novo pedido para Etapa 4"
      A     M      0.2;
      AN    T      2;
      AN    M      0.6;
      S     M      0.3;
      R     M      0.2;

NETWORK
TITLE = "Etapa 3 com novo pedido"
      A     M      0.2;
      AN    T      2;
      A     M      0.6;
      S     M      1.0;
      S     M      1.2;
      R     M      0.6;
      R     M      0.2;

NETWORK
TITLE = "Etapa 4 - TOF 30 s"
      A     M      0.3;
      FP    M      2.3;
      L     S5T#30S;
      SF    T      3;

NETWORK
TITLE = "Etapa 4 para Etapa 5"
      A     M      0.3;
      AN    T      3;
      S     M      0.4;
      R     M      0.3;

NETWORK
TITLE = "Etapa 5 - TOF 4 s"
      A     M      0.4;
      FP    M      2.4;
      L     S5T#4S;
      SF    T      4;

NETWORK
TITLE = "Etapa 5 sem pedestre para Etapa 6"
      A     M      0.4;
      AN    T      4;
      AN    M      0.6;
      S     M      0.5;
      R     M      0.4;

NETWORK
TITLE = "Etapa 5 com pedestre"
      A     M      0.4;
      AN    T      4;
      A     M      0.6;
      S     M      1.0;
      R     M      1.2;
      R     M      0.6;
      R     M      0.4;

NETWORK
TITLE = "Etapa 6 - TOF 2 s"
      A     M      0.5;
      FP    M      2.5;
      L     S5T#2S;
      SF    T      5;

NETWORK
TITLE = "Etapa 6 sem novo pedido para Etapa 1"
      A     M      0.5;
      AN    T      5;
      AN    M      0.6;
      S     M      0.0;
      R     M      0.5;

NETWORK
TITLE = "Etapa 6 com novo pedido"
      A     M      0.5;
      AN    T      5;
      A     M      0.6;
      S     M      1.0;
      R     M      1.2;
      R     M      0.6;
      R     M      0.5;

NETWORK
TITLE = "Pedestre verde - TOF 15 s"
      A     M      1.0;
      FP    M      2.6;
      L     S5T#15S;
      SF    T      6;

NETWORK
TITLE = "Pedestre verde para vermelho piscante"
      A     M      1.0;
      AN    T      6;
      S     M      1.1;
      S     M      1.3;
      R     M      1.0;

NETWORK
TITLE = "Pedestre piscante - TOF total 5 s"
      A     M      1.1;
      FP    M      2.7;
      L     S5T#5S;
      SF    T      7;

NETWORK
TITLE = "Fim pedestre - retoma Via 1"
      A     M      1.1;
      AN    T      7;
      A     M      1.2;
      S     M      0.3;
      R     M      1.3;
      R     M      1.4;
      R     M      1.1;
      R     M      1.2;

NETWORK
TITLE = "Fim pedestre - retoma Via 2"
      A     M      1.1;
      AN    T      7;
      AN    M      1.2;
      S     M      0.0;
      R     M      1.3;
      R     M      1.4;
      R     M      1.1;

NETWORK
TITLE = "Pisca pedestre - fase ligada TOF 500 ms"
      A     M      1.1;
      A     M      1.3;
      FP    M      3.0;
      L     S5T#500MS;
      SF    T      8;

NETWORK
TITLE = "Pisca pedestre - ligada para desligada"
      A     M      1.1;
      A     M      1.3;
      AN    T      8;
      S     M      1.4;
      R     M      1.3;

NETWORK
TITLE = "Pisca pedestre - fase desligada TOF 500 ms"
      A     M      1.1;
      A     M      1.4;
      FP    M      3.1;
      L     S5T#500MS;
      SF    T      9;

NETWORK
TITLE = "Pisca pedestre - desligada para ligada"
      A     M      1.1;
      A     M      1.4;
      AN    T      9;
      S     M      1.3;
      R     M      1.4;

NETWORK
TITLE = "Saida - Verde Via 1"
      A     M      0.3;
      =     Q      0.0;

NETWORK
TITLE = "Saida - Amarelo Via 1"
      A     M      0.4;
      =     Q      0.1;

NETWORK
TITLE = "Saida - Vermelho Via 1"
      A     M      0.0;
      O     M      0.1;
      O     M      0.2;
      O     M      0.5;
      O     M      1.0;
      O     M      1.1;
      =     Q      0.2;

NETWORK
TITLE = "Saida - Verde Via 2"
      A     M      0.0;
      =     Q      0.3;

NETWORK
TITLE = "Saida - Amarelo Via 2"
      A     M      0.1;
      =     Q      0.4;

NETWORK
TITLE = "Saida - Vermelho Via 2"
      A     M      0.2;
      O     M      0.3;
      O     M      0.4;
      O     M      0.5;
      O     M      1.0;
      O     M      1.1;
      =     Q      0.5;

NETWORK
TITLE = "Saida - Verde Pedestre"
      A     M      1.0;
      =     Q      0.6;

NETWORK
TITLE = "Saida - Vermelho Pedestre"
      AN    M      1.1;
      O     M      1.3;
      AN    M      1.0;
      =     Q      0.7;

END_ORGANIZATION_BLOCK
