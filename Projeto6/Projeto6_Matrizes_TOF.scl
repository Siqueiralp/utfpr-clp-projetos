TYPE UDT106
STRUCT
    estado : ARRAY[0..9] OF BYTE;
    tempo : ARRAY[0..9] OF S5TIME;
END_STRUCT;
END_TYPE

FUNCTION_BLOCK FB106
TITLE = 'Projeto 6 - matriz e um TOF'
VAR
    tabela : UDT106;
    iniciado : BOOL := FALSE;
    etapa : INT := 0;
    pedido : BOOL := FALSE;
    botaoAnterior : BOOL := FALSE;
    pulsoInicio : BOOL := TRUE;
END_VAR
VAR_TEMP
    tempoAtivo : BOOL;
    restante : WORD;
    resultado : S5TIME;
END_VAR
BEGIN
    IF NOT iniciado THEN
        tabela.estado[0] := B#16#8C; tabela.tempo[0] := T#30S;
        tabela.estado[1] := B#16#94; tabela.tempo[1] := T#4S;
        tabela.estado[2] := B#16#A4; tabela.tempo[2] := T#2S;
        tabela.estado[3] := B#16#A1; tabela.tempo[3] := T#30S;
        tabela.estado[4] := B#16#A2; tabela.tempo[4] := T#4S;
        tabela.estado[5] := B#16#A4; tabela.tempo[5] := T#2S;
        tabela.estado[6] := B#16#64; tabela.tempo[6] := T#15S;
        tabela.estado[7] := B#16#A4; tabela.tempo[7] := T#5S;
        tabela.estado[8] := B#16#64; tabela.tempo[8] := T#15S;
        tabela.estado[9] := B#16#A4; tabela.tempo[9] := T#5S;
        iniciado := TRUE;
    END_IF;

    IF I0.0 AND NOT botaoAnterior THEN pedido := TRUE; END_IF;
    botaoAnterior := I0.0;

    resultado := S_OFFDT(T_NO := T60, S := pulsoInicio,
                         TV := tabela.tempo[etapa], R := FALSE,
                         BI := restante, Q := tempoAtivo);

    IF pulsoInicio THEN
        pulsoInicio := FALSE;
    ELSIF NOT tempoAtivo THEN
        CASE etapa OF
            0: etapa := 1;
            1:
                IF pedido THEN etapa := 6; pedido := FALSE;
                ELSE etapa := 2; END_IF;
            2:
                IF pedido THEN etapa := 6; pedido := FALSE;
                ELSE etapa := 3; END_IF;
            3: etapa := 4;
            4:
                IF pedido THEN etapa := 8; pedido := FALSE;
                ELSE etapa := 5; END_IF;
            5:
                IF pedido THEN etapa := 8; pedido := FALSE;
                ELSE etapa := 0; END_IF;
            6: etapa := 7;
            7: etapa := 3;
            8: etapa := 9;
            9: etapa := 0;
        ELSE
            etapa := 0;
        END_CASE;
        pulsoInicio := TRUE;
    END_IF;

    QB0 := tabela.estado[etapa];
    IF (etapa = 7) OR (etapa = 9) THEN
        IF NOT M10.5 THEN QB0 := B#16#24; END_IF;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB106.DB106();
END_ORGANIZATION_BLOCK
