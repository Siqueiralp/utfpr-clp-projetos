FUNCTION_BLOCK FB214
TITLE = 'Projeto 14 - chave reversora minima'
VAR
    estado : INT := 1;             // 0=parado, 1=frente, 2=reverso
    automatico : BOOL := TRUE;
    armaTempo : BOOL := FALSE;
END_VAR
VAR_TEMP
    fimTempo : BOOL;
    resultado : S5TIME;
END_VAR
BEGIN
    // Manual tem prioridade sobre o automatico.
    IF I0.3 OR (I0.0 AND I0.1) THEN
        estado := 0;
        automatico := FALSE;
        armaTempo := FALSE;

    ELSIF I0.0 THEN
        estado := 1;
        automatico := FALSE;
        armaTempo := FALSE;

    ELSIF I0.1 THEN
        estado := 2;
        automatico := FALSE;
        armaTempo := FALSE;

    ELSIF I0.2 THEN
        automatico := TRUE;
        armaTempo := FALSE;
        IF estado = 0 THEN estado := 1; END_IF;
    END_IF;

    resultado := S_ODT(T_NO := T140,
                       S := armaTempo AND automatico,
                       TV := T#5S, R := NOT automatico,
                       Q := fimTempo);

    IF automatico THEN
        IF fimTempo THEN
            armaTempo := FALSE;
            IF estado = 1 THEN estado := 2;
            ELSE estado := 1; END_IF;
        ELSIF NOT armaTempo THEN
            armaTempo := TRUE;
        END_IF;
    END_IF;

    Q0.0 := estado = 1;
    Q0.1 := estado = 2;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB214.DB214();
END_ORGANIZATION_BLOCK
