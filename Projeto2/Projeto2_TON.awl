      ==I;
      =     Q      0.3;

NETWORK
TITLE = "Saida - Amarelo Via 2"
      L     MW    20;
      L     1;
      ==I;
      =     Q      0.4;

NETWORK
TITLE = "Saida - Vermelho Via 2"
      L     MW    20;
      L     0;
      <>I;
      A(
      L     MW    20;
      L     1;
      <>I;
      );
      =     Q      0.5;

NETWORK
TITLE = "Saida - Verde Pedestre"
      L     MW    20;
      L     6;
      ==I;
      O(
      L     MW    20;
      L     8;
      ==I;
      );
      =     Q      0.6;

NETWORK
TITLE = "Saida - Vermelho Pedestre normal"
      L     MW    20;
      L     5;
      <=I;
      =     Q      0.7;

NETWORK
TITLE = "Saida - Vermelho Pedestre piscante"
      L     MW    20;
      L     7;
      ==I;
      O(
      L     MW    20;
      L     9;
      ==I;
      );
      A     M     10.5;
      S     Q      0.7;

END_ORGANIZATION_BLOCK
