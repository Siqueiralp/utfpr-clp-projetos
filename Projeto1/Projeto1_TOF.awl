ORGANIZATION_BLOCK OB 1
TITLE = "Projeto 1 - Semaforo LAD com TOF simplificado"
VERSION : 0.2

VAR_TEMP
  OB1_EV_CLASS : BYTE ;
  OB1_SCAN_1 : BYTE ;
  OB1_PRIORITY : BYTE ;
  OB1_OB_NUMBR : BYTE ;
  OB1_RESERVED_1 : BYTE ;
  OB1_RESERVED_2 : BYTE ;
  OB1_PREV_CYCLE : INT ;
  OB1_MIN_CYCLE : INT ;
  OB1_MAX_CYCLE : INT ;
  OB1_DATE_TIME : DATE_AND_TIME ;
END_VAR

BEGIN

NETWORK
TITLE = "Inicializacao"
      AN    M      0.7;
      S     M      0.0;
      S     M      0.7;
      S     M      2.0;

NETWORK
TITLE = "Memoriza pedido de pedestre"
      A     I      0.0;
      FP    M      2.2;
      S     M      0.6;

NETWORK
TITLE = "TOF compartilhado 30 s - etapas 1 e 4"
      A     M      0.0;
      O     M      0.3;
      A     M      2.0;
      L     S5T#30S;
      SF    T      0;

NETWORK
TITLE = "TOF compartilhado 4 s - etapas 2 e 5"
      A     M      0.1;
      O     M      0.4;
      A     M      2.0;
      L     S5T#4S;
      SF    T      1;

NETWORK
TITLE = "TOF compartilhado 2 s - etapas 3 e 6"
      A     M      0.2;
      O     M      0.5;
      A     M      2.0;
      L     S5T#2S;
      SF    T      2;

NETWORK
TITLE = "TOF 15 s - pedestre verde"
      A     M      1.0;
      A     M      2.0;
      L     S5T#15S;
      SF    T      3;

NETWORK
TITLE = "TOF 5 s - pedestre piscante"
      A     M      1.1;
      A     M      2.0;
      L     S5T#5S;
      SF    T      4;

NETWORK
TITLE = "TOF 500 ms - fase do pisca"
      A     M      1.1;
      A     M      2.1;
      L     S5T#500MS;
      SF    T      5;

NETWORK
TITLE = "Consome pulsos de partida dos TOF"
      A     M      0.7;
      R     M      2.0;
      R     M      2.1;

NETWORK
TITLE = "Etapa 1 para Etapa 2"
      A     M      0.0;
      AN    M      2.0;
      AN    T      0;
      S     M      0.1;
      R     M      0.0;
      S     M      2.0;

NETWORK
TITLE = "Etapa 2 para Etapa 3"
      A     M      0.1;
      AN    M      2.0;
      AN    T      1;
      AN    M      0.6;
      S     M      0.2;
      R     M      0.1;
      S     M      2.0;

NETWORK
TITLE = "Etapa 2 para pedestre"
      A     M      0.1;
      AN    M      2.0;
      AN    T      1;
      A     M      0.6;
      S     M      1.0;
      S     M      1.2;
      R     M      0.6;
      R     M      0.1;
      S     M      2.0;

NETWORK
TITLE = "Etapa 3 para Etapa 4"
      A     M      0.2;
      AN    M      2.0;
      AN    T      2;
      AN    M      0.6;
      S     M      0.3;
      R     M      0.2;
      S     M      2.0;

NETWORK
TITLE = "Etapa 3 para pedestre"
      A     M      0.2;
      AN    M      2.0;
      AN    T      2;
      A     M      0.6;
      S     M      1.0;
      S     M      1.2;
      R     M      0.6;
      R     M      0.2;
      S     M      2.0;

NETWORK
TITLE = "Etapa 4 para Etapa 5"
      A     M      0.3;
      AN    M      2.0;
      AN    T      0;
      S     M      0.4;
      R     M      0.3;
      S     M      2.0;

NETWORK
TITLE = "Etapa 5 para Etapa 6"
      A     M      0.4;
      AN    M      2.0;
      AN    T      1;
      AN    M      0.6;
      S     M      0.5;
      R     M      0.4;
      S     M      2.0;

NETWORK
TITLE = "Etapa 5 para pedestre"
      A     M      0.4;
      AN    M      2.0;
      AN    T      1;
      A     M      0.6;
      S     M      1.0;
      R     M      1.2;
      R     M      0.6;
      R     M      0.4;
      S     M      2.0;

NETWORK
TITLE = "Etapa 6 para Etapa 1"
      A     M      0.5;
      AN    M      2.0;
      AN    T      2;
      AN    M      0.6;
      S     M      0.0;
      R     M      0.5;
      S     M      2.0;

NETWORK
TITLE = "Etapa 6 para pedestre"
      A     M      0.5;
      AN    M      2.0;
      AN    T      2;
      A     M      0.6;
      S     M      1.0;
      R     M      1.2;
      R     M      0.6;
      R     M      0.5;
      S     M      2.0;

NETWORK
TITLE = "Pedestre verde para piscante"
      A     M      1.0;
      AN    M      2.0;
      AN    T      3;
      S     M      1.1;
      S     M      1.3;
      R     M      1.4;
      R     M      1.0;
      S     M      2.0;
      S     M      2.1;

NETWORK
TITLE = "Fim pedestre - retoma Via 1"
      A     M      1.1;
      AN    M      2.0;
      AN    T      4;
      A     M      1.2;
      S     M      0.3;
      R     M      1.1;
      R     M      1.2;
      R     M      1.3;
      R     M      1.4;
      R     M      2.1;
      S     M      2.0;

NETWORK
TITLE = "Fim pedestre - retoma Via 2"
      A     M      1.1;
      AN    M      2.0;
      AN    T      4;
      AN    M      1.2;
      S     M      0.0;
      R     M      1.1;
      R     M      1.3;
      R     M      1.4;
      R     M      2.1;
      S     M      2.0;

NETWORK
TITLE = "Detecta fim de 500 ms - fase ligada"
      A     M      1.1;
      AN    M      2.1;
      AN    T      5;
      A     M      1.3;
      =     M      2.3;

NETWORK
TITLE = "Detecta fim de 500 ms - fase desligada"
      A     M      1.1;
      AN    M      2.1;
      AN    T      5;
      A     M      1.4;
      =     M      2.4;

NETWORK
TITLE = "Pisca: ligada para desligada"
      A     M      2.3;
      S     M      1.4;
      R     M      1.3;
      S     M      2.1;

NETWORK
TITLE = "Pisca: desligada para ligada"
      A     M      2.4;
      S     M      1.3;
      R     M      1.4;
      S     M      2.1;

NETWORK
TITLE = "Saida - Verde Via 1"
      A     M      0.3;
      =     Q      0.0;

NETWORK
TITLE = "Saida - Amarelo Via 1"
      A     M      0.4;
      =     Q      0.1;

NETWORK
TITLE = "Saida - Vermelho Via 1"
      A     M      0.0;
      O     M      0.1;
      O     M      0.2;
      O     M      0.5;
      O     M      1.0;
      O     M      1.1;
      =     Q      0.2;

NETWORK
TITLE = "Saida - Verde Via 2"
      A     M      0.0;
      =     Q      0.3;

NETWORK
TITLE = "Saida - Amarelo Via 2"
      A     M      0.1;
      =     Q      0.4;

NETWORK
TITLE = "Saida - Vermelho Via 2"
      A     M      0.2;
      O     M      0.3;
      O     M      0.4;
      O     M      0.5;
      O     M      1.0;
      O     M      1.1;
      =     Q      0.5;

NETWORK
TITLE = "Saida - Verde Pedestre"
      A     M      1.0;
      =     Q      0.6;

NETWORK
TITLE = "Saida - Vermelho Pedestre"
      AN    M      1.1;
      O     M      1.3;
      AN    M      1.0;
      =     Q      0.7;

END_ORGANIZATION_BLOCK
