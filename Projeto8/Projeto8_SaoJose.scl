// Requer FB107 do Projeto 7 ja compilado no mesmo S7 Program.
FUNCTION_BLOCK FB108
TITLE = 'Projetos 8 e 9 - semaforo de 13 lampadas'
VAR_INPUT
    Maceio : BOOL;               // FALSE: Sao Jose; TRUE: Maceio
    TempoVermelho : S5TIME;
    TempoVerde : S5TIME;
    TempoAmarelo : S5TIME;
    TempoDeslocamento : S5TIME;
END_VAR
VAR
    reg : FB107;
    fase : INT := 0;
    pronto : BOOL := FALSE;
    alto : BOOL := FALSE;
    contador : INT := -1;         // -1=inicializa grupo; depois sementes/deslocamentos
    armaTempo : BOOL := FALSE;
END_VAR
VAR_TEMP
    resetReg : BOOL;
    pulsoReg : BOOL;
    dadoReg : BOOL;
    alvo : INT;
    limite : INT;
    fimTempo : BOOL;
    duracao : S5TIME;
    restante : WORD;
    resultado : S5TIME;
END_VAR
BEGIN
    resetReg := FALSE;
    pulsoReg := FALSE;
    dadoReg := FALSE;

    IF Maceio THEN
        alvo := 6;
        limite := 6;
    ELSE
        alvo := 1;
        limite := 5;
    END_IF;

    // Um unico registrador e um unico contador servem aos dois grupos.
    IF contador < 0 THEN
        resetReg := TRUE;
        contador := 0;
        alto := FALSE;
        pronto := FALSE;

    ELSIF ((fase = 0) OR (fase = 3)) AND NOT pronto THEN
        IF NOT alto THEN
            alto := TRUE;
            contador := contador + 1;
            pulsoReg := TRUE;
            dadoReg := TRUE;
        ELSE
            alto := FALSE;
            IF contador >= alvo THEN
                pronto := TRUE;
                contador := 0;
            END_IF;
        END_IF;
    END_IF;

    IF fase = 0 THEN duracao := TempoVermelho;
    ELSIF fase = 3 THEN duracao := TempoVerde;
    ELSIF (fase = 2) OR (fase = 5) THEN duracao := TempoAmarelo;
    ELSE duracao := TempoDeslocamento;
    END_IF;

    resultado := S_ODT(T_NO := T80, S := armaTempo AND pronto,
                       TV := duracao, R := FALSE,
                       BI := restante, Q := fimTempo);

    IF pronto THEN
        IF fimTempo THEN
            armaTempo := FALSE;
            CASE fase OF
                0: fase := 1;
                1:
                    IF contador < limite THEN
                        pulsoReg := TRUE;
                        contador := contador + 1;
                    ELSE
                        fase := 2;
                    END_IF;
                2:
                    fase := 3;
                    contador := -1;
                    pronto := FALSE;
                3: fase := 4;
                4:
                    IF contador < limite THEN
                        pulsoReg := TRUE;
                        contador := contador + 1;
                    ELSE
                        fase := 5;
                    END_IF;
                5:
                    fase := 0;
                    contador := -1;
                    pronto := FALSE;
            ELSE
                fase := 0;
                novoGrupo := TRUE;
                pronto := FALSE;
            END_CASE;
        ELSIF NOT armaTempo THEN
            armaTempo := TRUE;
        END_IF;
    END_IF;

    IF (fase = 2) OR (fase = 5) THEN pronto := TRUE; END_IF;

    reg(Forwardpulse := pulsoReg, Forwarddata := dadoReg,
        Backwardpulse := FALSE, Backwarddata := FALSE,
        Reset := resetReg);

    // Escrita por BYTE substitui 13 atribuicoes BOOL por scan.
    QB0 := B#16#00;
    QB1 := B#16#00;

    IF (fase = 0) OR (fase = 1) THEN
        IF NOT pronto THEN
            IF Maceio THEN QB0 := B#16#3F;
            ELSE QB0 := B#16#01; END_IF;
        ELSE
            QB0 := reg.Data AND B#16#3F;
        END_IF;
    ELSIF (fase = 3) OR (fase = 4) THEN
        IF NOT pronto THEN
            IF Maceio THEN QB1 := B#16#3F;
            ELSE QB1 := B#16#01; END_IF;
        ELSE
            QB1 := reg.Data AND B#16#3F;
        END_IF;
    ELSE
        QB0 := B#16#40;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB108.DB108(Maceio := FALSE, TempoVermelho := T#30S,
                TempoVerde := T#30S, TempoAmarelo := T#4S,
                TempoDeslocamento := T#1S);
END_ORGANIZATION_BLOCK
