FUNCTION_BLOCK FB104
TITLE = 'Projeto 4 - um timer, contador e comparadores'
VAR
    etapa : INT := 0;
    volta : INT := 3;
    pedido : BOOL := FALSE;
    botaoAnterior : BOOL := FALSE;
    armaPulso : BOOL := FALSE;
    fimPulso : BOOL := FALSE;
    pulso : BOOL := FALSE;
    zeraContador : BOOL := TRUE;
    total : INT;
    limite : INT;
    ticks : WORD;
    bcd : WORD;
    ativo : BOOL;
    restante : WORD;
    tempo : S5TIME;
END_VAR
BEGIN
    IF I0.0 AND NOT botaoAnterior THEN pedido := TRUE; END_IF;
    botaoAnterior := I0.0;

    // O unico temporizador gera um pulso a cada 0,5 s.
    tempo := S_ODT(T_NO := T40, S := armaPulso,
                   TV := T#500MS, R := FALSE,
                   BI := restante, Q := fimPulso);
    pulso := FALSE;
    IF fimPulso THEN
        pulso := TRUE;
        armaPulso := FALSE;
    ELSIF NOT armaPulso THEN
        armaPulso := TRUE;
    END_IF;

    bcd := S_CU(C_NO := C40, CU := pulso, S := FALSE,
                PV := 0, R := zeraContador, CV := ticks, Q := ativo);
    zeraContador := FALSE;
    total := WORD_TO_INT(ticks);
    CASE etapa OF
        0, 3: limite := 60;
        1, 4: limite := 8;
        2, 5: limite := 4;
        6: limite := 30;
        7: limite := 10;
    ELSE
        etapa := 0; limite := 60; zeraContador := TRUE;
    END_CASE;

    IF total >= limite THEN
        zeraContador := TRUE;
        CASE etapa OF
            0: etapa := 1;
            1, 2: IF pedido THEN
                      etapa := 6; volta := 3; pedido := FALSE;
                  ELSE
                      IF etapa = 1 THEN etapa := 2; ELSE etapa := 3; END_IF;
                  END_IF;
            3: etapa := 4;
            4, 5: IF pedido THEN
                      etapa := 6; volta := 0; pedido := FALSE;
                  ELSE
                      IF etapa = 4 THEN etapa := 5; ELSE etapa := 0; END_IF;
                  END_IF;
            6: etapa := 7;
            7: etapa := volta;
        END_CASE;
    END_IF;

    CASE etapa OF
        0: QB0 := B#16#8C;
        1: QB0 := B#16#94;
        2, 5: QB0 := B#16#A4;
        3: QB0 := B#16#A1;
        4: QB0 := B#16#A2;
        6: QB0 := B#16#64;
        7: IF (total MOD 2) = 0 THEN QB0 := B#16#A4;
           ELSE QB0 := B#16#24; END_IF;
    ELSE
        QB0 := B#16#A4;
    END_CASE;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB104.DB104();
END_ORGANIZATION_BLOCK
