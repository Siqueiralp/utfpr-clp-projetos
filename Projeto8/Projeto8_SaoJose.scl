// Requer FB107 do Projeto 7 ja compilado no mesmo S7 Program.
FUNCTION_BLOCK FB108
TITLE = 'Projetos 8 e 9 - semaforo de 13 lampadas minimo'
VAR_INPUT
    Maceio : BOOL;
    TempoVermelho : S5TIME;
    TempoVerde : S5TIME;
    TempoAmarelo : S5TIME;
    TempoDeslocamento : S5TIME;
END_VAR
VAR
    reg : FB107;
    fase : INT := 0;              // reset/seed/hold/shift/yellow para cada cor
    contador : INT := 0;
    armaTempo : BOOL := FALSE;
END_VAR
VAR_TEMP
    resetReg : BOOL;
    pulsoReg : BOOL;
    dadoReg : BOOL;
    alvo : INT;
    limite : INT;
    fimTempo : BOOL;
    duracao : S5TIME;
    restante : WORD;
    resultado : S5TIME;
END_VAR
BEGIN
    resetReg := FALSE;
    pulsoReg := FALSE;
    dadoReg := FALSE;

    IF Maceio THEN
        alvo := 6;
        limite := 6;
    ELSE
        alvo := 1;
        limite := 5;
    END_IF;

    // Fases 0..4 = vermelho; 5..9 = verde.
    CASE fase OF
        0:  // reset vermelho
            resetReg := TRUE;
            contador := 0;
            fase := 1;

        1:  // semeia vermelho
            pulsoReg := TRUE;
            dadoReg := TRUE;
            contador := contador + 1;
            IF contador >= alvo THEN
                contador := 0;
                fase := 2;
            END_IF;

        2: duracao := TempoVermelho;       // patamar vermelho
        3: duracao := TempoDeslocamento;   // desloca vermelho
        4: duracao := TempoAmarelo;

        5:  // reset verde
            resetReg := TRUE;
            contador := 0;
            fase := 6;

        6:  // semeia verde
            pulsoReg := TRUE;
            dadoReg := TRUE;
            contador := contador + 1;
            IF contador >= alvo THEN
                contador := 0;
                fase := 7;
            END_IF;

        7: duracao := TempoVerde;          // patamar verde
        8: duracao := TempoDeslocamento;   // desloca verde
        9: duracao := TempoAmarelo;

    ELSE
        fase := 0;
    END_CASE;

    // Somente as fases temporizadas chamam T80.
    IF (fase = 2) OR (fase = 3) OR (fase = 4) OR
       (fase = 7) OR (fase = 8) OR (fase = 9) THEN

        resultado := S_ODT(T_NO := T80, S := armaTempo,
                           TV := duracao, R := FALSE,
                           BI := restante, Q := fimTempo);

        IF fimTempo THEN
            armaTempo := FALSE;

            CASE fase OF
                2:
                    contador := 0;
                    fase := 3;

                3:
                    pulsoReg := TRUE;
                    contador := contador + 1;
                    IF contador >= limite THEN
                        contador := 0;
                        fase := 4;
                    END_IF;

                4: fase := 5;

                7:
                    contador := 0;
                    fase := 8;

                8:
                    pulsoReg := TRUE;
                    contador := contador + 1;
                    IF contador >= limite THEN
                        contador := 0;
                        fase := 9;
                    END_IF;

                9: fase := 0;
            END_CASE;

        ELSIF NOT armaTempo THEN
            armaTempo := TRUE;
        END_IF;

    ELSE
        armaTempo := FALSE;
    END_IF;

    reg(Forwardpulse := pulsoReg, Forwarddata := dadoReg,
        Backwardpulse := FALSE, Backwarddata := FALSE,
        Reset := resetReg);

    QB0 := B#16#00;
    QB1 := B#16#00;

    IF (fase >= 1) AND (fase <= 3) THEN
        QB0 := reg.Data AND B#16#3F;
    ELSIF (fase >= 6) AND (fase <= 8) THEN
        QB1 := reg.Data AND B#16#3F;
    ELSE
        QB0 := B#16#40;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB108.DB108(Maceio := FALSE, TempoVermelho := T#30S,
                TempoVerde := T#30S, TempoAmarelo := T#4S,
                TempoDeslocamento := T#1S);
END_ORGANIZATION_BLOCK
