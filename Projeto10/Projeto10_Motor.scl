FUNCTION_BLOCK FB110
TITLE = 'Projeto 10 - quatro rampas com Clock Memory'
VAR
    etapa : INT := 7;              // 0/2 sobe; 4/6 desce; 1/3/5 patamar
    esperaTicks : INT := 0;
    anteriorStart : BOOL := FALSE;
    clockAnterior : BOOL := FALSE;
END_VAR
VAR_TEMP
    tick100ms : BOOL;
END_VAR
BEGIN
    // M10.0 = 10 Hz. A borda positiva ocorre uma vez a cada 100 ms.
    tick100ms := M10.0 AND NOT clockAnterior;
    clockAnterior := M10.0;

    IF I0.1 THEN
        etapa := 7;
        MW100 := 0;
        esperaTicks := 0;

    ELSIF I0.0 AND NOT anteriorStart AND (etapa = 7) THEN
        etapa := 0;
        MW100 := 0;
        esperaTicks := 0;

    ELSIF tick100ms THEN
        CASE etapa OF
            0:
                MW100 := MW100 + 32;
                IF MW100 >= 2048 THEN
                    MW100 := 2048;
                    etapa := 1;
                    esperaTicks := 0;
                END_IF;

            1:
                esperaTicks := esperaTicks + 1;
                IF esperaTicks >= 30 THEN etapa := 2; END_IF;

            2:
                MW100 := MW100 + 128;
                IF MW100 >= 4095 THEN
                    MW100 := 4095;
                    etapa := 3;
                    esperaTicks := 0;
                END_IF;

            3:
                esperaTicks := esperaTicks + 1;
                IF esperaTicks >= 50 THEN etapa := 4; END_IF;

            4:
                MW100 := MW100 - 128;
                IF MW100 <= 2048 THEN
                    MW100 := 2048;
                    etapa := 5;
                    esperaTicks := 0;
                END_IF;

            5:
                esperaTicks := esperaTicks + 1;
                IF esperaTicks >= 30 THEN etapa := 6; END_IF;

            6:
                MW100 := MW100 - 32;
                IF MW100 <= 0 THEN
                    MW100 := 0;
                    etapa := 7;
                END_IF;

            7:
                MW100 := 0;

        ELSE
            etapa := 7;
            MW100 := 0;
            esperaTicks := 0;
        END_CASE;
    END_IF;

    anteriorStart := I0.0;

    PQW256 := INT_TO_WORD(MW100);
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB110.DB110();
END_ORGANIZATION_BLOCK
