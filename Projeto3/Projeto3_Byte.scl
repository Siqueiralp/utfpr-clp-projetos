FUNCTION_BLOCK FB103
TITLE = 'Projeto 3 - semaforo por byte de estado'
VAR
    etapa : INT := 0;              // 0..5 ciclo; 6 verde ped; 7 pisca ped
    voltaVia1 : BOOL := TRUE;      // TRUE -> retoma etapa 3; FALSE -> etapa 0
    pedido : BOOL := FALSE;
    botaoAnterior : BOOL := FALSE;
    habilitaTempo : BOOL := FALSE;
END_VAR
VAR_TEMP
    fimTempo : BOOL;
    duracao : S5TIME;
    restante : WORD;
    resultado : S5TIME;
END_VAR
BEGIN
    IF I0.0 AND NOT botaoAnterior THEN pedido := TRUE; END_IF;
    botaoAnterior := I0.0;

    CASE etapa OF
        0, 3: duracao := T#30S;
        1, 4: duracao := T#4S;
        2, 5: duracao := T#2S;
        6: duracao := T#15S;
        7: duracao := T#5S;
    ELSE
        etapa := 0;
        duracao := T#30S;
    END_CASE;

    resultado := S_ODT(T_NO := T30, S := habilitaTempo,
                       TV := duracao, R := FALSE,
                       BI := restante, Q := fimTempo);

    IF fimTempo THEN
        habilitaTempo := FALSE;
        CASE etapa OF
            0: etapa := 1;
            1, 2:
                IF pedido THEN
                    etapa := 6;
                    voltaVia1 := TRUE;
                    pedido := FALSE;
                ELSE
                    IF etapa = 1 THEN etapa := 2; ELSE etapa := 3; END_IF;
                END_IF;
            3: etapa := 4;
            4, 5:
                IF pedido THEN
                    etapa := 6;
                    voltaVia1 := FALSE;
                    pedido := FALSE;
                ELSE
                    IF etapa = 4 THEN etapa := 5; ELSE etapa := 0; END_IF;
                END_IF;
            6: etapa := 7;
            7:
                IF voltaVia1 THEN etapa := 3; ELSE etapa := 0; END_IF;
        ELSE
            etapa := 0;
        END_CASE;
    ELSIF NOT habilitaTempo THEN
        habilitaTempo := TRUE;
    END_IF;

    // Escrita atomica do byte de saidas: menos logica e menos variaveis.
    CASE etapa OF
        0: QB0 := B#16#8C;      // V2 verde
        1: QB0 := B#16#94;      // V2 amarelo
        2, 5: QB0 := B#16#A4;   // ambas vermelhas
        3: QB0 := B#16#A1;      // V1 verde
        4: QB0 := B#16#A2;      // V1 amarelo
        6: QB0 := B#16#64;      // pedestre verde
        7:
            IF M10.5 THEN QB0 := B#16#A4;
            ELSE QB0 := B#16#24; END_IF;
    ELSE
        QB0 := B#16#A4;
    END_CASE;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB103.DB103();
END_ORGANIZATION_BLOCK
