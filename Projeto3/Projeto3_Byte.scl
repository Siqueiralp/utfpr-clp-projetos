FUNCTION_BLOCK FB103
TITLE = 'Projeto 3 - semaforo por byte de estado'
VAR
    etapa : INT := 0;              // 0..5 ciclo; 6 verde ped; 7 pisca ped
    volta : INT := 3;
    pedido : BOOL := FALSE;
    botaoAnterior : BOOL := FALSE;
    habilitaTempo : BOOL := FALSE;
    fimTempo : BOOL := FALSE;
    tempo : S5TIME;
    habilitaPisca : BOOL := FALSE;
    fimPisca : BOOL := FALSE;
    piscaAceso : BOOL := TRUE;
    restante : WORD;
END_VAR
BEGIN
    IF I0.0 AND NOT botaoAnterior THEN pedido := TRUE; END_IF;
    botaoAnterior := I0.0;

    CASE etapa OF
        0, 3: tempo := T#30S;
        1, 4: tempo := T#4S;
        2, 5: tempo := T#2S;
        6: tempo := T#15S;
        7: tempo := T#5S;
    ELSE
        etapa := 0;
        tempo := T#30S;
    END_CASE;

    tempo := S_ODT(T_NO := T30, S := habilitaTempo,
                   TV := tempo, R := FALSE, BI := restante, Q := fimTempo);
    IF fimTempo THEN
        habilitaTempo := FALSE;
        CASE etapa OF
            0: etapa := 1;
            1, 2: IF pedido THEN
                      etapa := 6; volta := 3; pedido := FALSE;
                  ELSE
                      IF etapa = 1 THEN etapa := 2; ELSE etapa := 3; END_IF;
                  END_IF;
            3: etapa := 4;
            4, 5: IF pedido THEN
                      etapa := 6; volta := 0; pedido := FALSE;
                  ELSE
                      IF etapa = 4 THEN etapa := 5; ELSE etapa := 0; END_IF;
                  END_IF;
            6: etapa := 7; piscaAceso := TRUE;
            7: etapa := volta;
        END_CASE;
    ELSIF NOT habilitaTempo THEN
        habilitaTempo := TRUE;
    END_IF;

    tempo := S_ODT(T_NO := T31, S := habilitaPisca AND (etapa = 7),
                   TV := T#500MS, R := FALSE, Q := fimPisca);
    IF etapa <> 7 THEN
        habilitaPisca := FALSE;
        piscaAceso := TRUE;
    ELSIF fimPisca THEN
        habilitaPisca := FALSE;
        piscaAceso := NOT piscaAceso;
    ELSIF NOT habilitaPisca THEN
        habilitaPisca := TRUE;
    END_IF;

    // Q0: V1 verde, amarelo, vermelho; V2 verde, amarelo, vermelho;
    //      pedestre verde, vermelho. Cada valor abaixo representa as 8 lampadas.
    CASE etapa OF
        0: QB0 := B#16#8C; // 140
        1: QB0 := B#16#94; // 148
        2, 5: QB0 := B#16#A4; // 164
        3: QB0 := B#16#A1; // 161
        4: QB0 := B#16#A2; // 162
        6: QB0 := B#16#64; // 100
        7: IF piscaAceso THEN QB0 := B#16#A4;
           ELSE QB0 := B#16#24; END_IF;
    ELSE
        QB0 := B#16#A4;
    END_CASE;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB103.DB103();
END_ORGANIZATION_BLOCK
