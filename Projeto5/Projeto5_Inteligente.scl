FUNCTION_BLOCK FB105
TITLE = 'Projeto 5 - fluxo e alerta noturno minimo'
VAR
    etapa : INT := 0;
    pedido : BOOL := FALSE;
    botaoAnterior : BOOL := FALSE;

    fluxo1 : INT := 0;
    fluxo2 : INT := 0;

    noite : BOOL := FALSE;
    minutoAnterior : INT := -1;
    clockAnterior : BOOL := FALSE;
    zeraFluxo : BOOL := TRUE;

    armaEtapa : BOOL := FALSE;
END_VAR
VAR_TEMP
    agora : DATE_AND_TIME;
    bytesAgora AT agora : ARRAY[0..7] OF BYTE;
    retornoRelogio : INT;
    horaAtual : INT;
    minutoAtual : INT;
    atualizaRelogio : BOOL;
    fechaJanela : BOOL;

    valor1 : WORD;
    valor2 : WORD;
    bcd1 : WORD;
    bcd2 : WORD;
    ativo1 : BOOL;
    ativo2 : BOOL;

    fimEtapa : BOOL;
    duracao : S5TIME;
    restante : WORD;
    resultado : S5TIME;
END_VAR
BEGIN
    // RTC lido apenas na borda de M10.7 (uma vez a cada 2 s).
    atualizaRelogio := M10.7 AND NOT clockAnterior;
    clockAnterior := M10.7;

    fechaJanela := FALSE;

    IF atualizaRelogio THEN
        retornoRelogio := SFC1(CDT := agora);
        IF retornoRelogio = 0 THEN
            horaAtual := BCD_TO_INT(BYTE_TO_WORD(bytesAgora[3]));
            minutoAtual := BCD_TO_INT(BYTE_TO_WORD(bytesAgora[4]));
            noite := (horaAtual >= 22) OR (horaAtual < 6);

            // A mudanca de minuto fecha a janela de contagem de 60 s.
            IF (minutoAnterior >= 0) AND (minutoAtual <> minutoAnterior) THEN
                fechaJanela := TRUE;
            END_IF;
            minutoAnterior := minutoAtual;
        END_IF;
    END_IF;

    bcd1 := S_CU(C_NO := C51, CU := I0.1, S := FALSE, PV := 0,
                 R := zeraFluxo, CV := valor1, Q := ativo1);
    bcd2 := S_CU(C_NO := C52, CU := I0.2, S := FALSE, PV := 0,
                 R := zeraFluxo, CV := valor2, Q := ativo2);

    // zeraFluxo pertence a janela anterior; apos a chamada ele ja pode cair.
    IF zeraFluxo THEN zeraFluxo := FALSE; END_IF;

    // Captura primeiro; o reset dos contadores ocorre no scan seguinte.
    IF fechaJanela THEN
        fluxo1 := WORD_TO_INT(valor1);
        fluxo2 := WORD_TO_INT(valor2);
        zeraFluxo := TRUE;
    END_IF;

    IF I0.0 AND NOT botaoAnterior THEN pedido := TRUE; END_IF;
    botaoAnterior := I0.0;

    IF noite THEN
        etapa := 0;
        armaEtapa := FALSE;
        pedido := FALSE;
    ELSE
        CASE etapa OF
            0:
                IF fluxo2 < 20 THEN duracao := T#20S;
                ELSIF fluxo2 <= 40 THEN duracao := T#40S;
                ELSE duracao := T#60S; END_IF;
            3:
                IF fluxo1 < 20 THEN duracao := T#20S;
                ELSIF fluxo1 <= 40 THEN duracao := T#40S;
                ELSE duracao := T#60S; END_IF;
            1, 4: duracao := T#4S;
            2, 5: duracao := T#2S;
            6, 8: duracao := T#15S;
            7, 9: duracao := T#5S;
        ELSE
            etapa := 0;
            duracao := T#20S;
        END_CASE;

        resultado := S_ODT(T_NO := T52, S := armaEtapa,
                           TV := duracao, R := FALSE,
                           BI := restante, Q := fimEtapa);

        IF fimEtapa THEN
            armaEtapa := FALSE;
            CASE etapa OF
                0: etapa := 1;
                1:
                    IF pedido THEN etapa := 6; pedido := FALSE;
                    ELSE etapa := 2; END_IF;
                2:
                    IF pedido THEN etapa := 6; pedido := FALSE;
                    ELSE etapa := 3; END_IF;
                3: etapa := 4;
                4:
                    IF pedido THEN etapa := 8; pedido := FALSE;
                    ELSE etapa := 5; END_IF;
                5:
                    IF pedido THEN etapa := 8; pedido := FALSE;
                    ELSE etapa := 0; END_IF;
                6: etapa := 7;
                7: etapa := 3;
                8: etapa := 9;
                9: etapa := 0;
            ELSE
                etapa := 0;
            END_CASE;
        ELSIF NOT armaEtapa THEN
            armaEtapa := TRUE;
        END_IF;
    END_IF;

    IF noite THEN
        IF M10.5 THEN QB0 := B#16#92;
        ELSE QB0 := B#16#80; END_IF;
    ELSE
        CASE etapa OF
            0: QB0 := B#16#8C;
            1: QB0 := B#16#94;
            2, 5: QB0 := B#16#A4;
            3: QB0 := B#16#A1;
            4: QB0 := B#16#A2;
            6, 8: QB0 := B#16#64;
            7, 9:
                IF M10.5 THEN QB0 := B#16#A4;
                ELSE QB0 := B#16#24; END_IF;
        ELSE
            QB0 := B#16#A4;
        END_CASE;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB105.DB105();
END_ORGANIZATION_BLOCK
