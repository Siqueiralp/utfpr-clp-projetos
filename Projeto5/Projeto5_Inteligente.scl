FUNCTION_BLOCK FB105
TITLE = 'Projeto 5 - fluxo e alerta noturno'
VAR
    etapa : INT := 0;
    volta : INT := 3;
    pedido : BOOL := FALSE;
    botaoAnterior : BOOL := FALSE;
    fluxo1 : INT := 0;             // veiculos por minuto da via 1
    fluxo2 : INT := 0;             // veiculos por minuto da via 2
    verdeEscolhido : S5TIME := T#20S;
    hora : INT := 12;
    noiteAnterior : BOOL := FALSE;
    armaJanela : BOOL := FALSE;
    fimJanela : BOOL := FALSE;
    zeraFluxo : BOOL := TRUE;
    valor1 : WORD;
    valor2 : WORD;
    bcd1 : WORD;
    bcd2 : WORD;
    ativo1 : BOOL;
    ativo2 : BOOL;
    armaEtapa : BOOL := FALSE;
    fimEtapa : BOOL := FALSE;
    duracao : S5TIME;
    armaPisca : BOOL := FALSE;
    fimPisca : BOOL := FALSE;
    piscaAceso : BOOL := TRUE;
    restante : WORD;
    tempo : S5TIME;
END_VAR
VAR_TEMP
    agora : DATE_AND_TIME;
    bytesAgora AT agora : ARRAY[0..7] OF BYTE;
    retornoRelogio : INT;
    noite : BOOL;
END_VAR
BEGIN
    retornoRelogio := SFC1(CDT := agora);
    IF retornoRelogio = 0 THEN
        hora := BCD_TO_INT(BYTE_TO_WORD(bytesAgora[3]));
    END_IF;
    noite := (hora >= 22) OR (hora < 6); // ajuste somente aqui

    bcd1 := S_CU(C_NO := C51, CU := I0.1, S := FALSE, PV := 0,
                 R := zeraFluxo, CV := valor1, Q := ativo1);
    bcd2 := S_CU(C_NO := C52, CU := I0.2, S := FALSE, PV := 0,
                 R := zeraFluxo, CV := valor2, Q := ativo2);
    zeraFluxo := FALSE;
    tempo := S_ODT(T_NO := T51, S := armaJanela, TV := T#60S,
                   R := FALSE, Q := fimJanela);
    IF fimJanela THEN
        fluxo1 := WORD_TO_INT(valor1);
        fluxo2 := WORD_TO_INT(valor2);
        zeraFluxo := TRUE;
        armaJanela := FALSE;
    ELSIF NOT armaJanela THEN
        armaJanela := TRUE;
    END_IF;

    IF I0.0 AND NOT botaoAnterior THEN pedido := TRUE; END_IF;
    botaoAnterior := I0.0;

    IF noite THEN
        armaEtapa := FALSE;
        etapa := 0;
        pedido := FALSE;
    ELSIF noiteAnterior THEN
        etapa := 0;
        armaEtapa := FALSE;
        IF fluxo2 < 20 THEN verdeEscolhido := T#20S;
        ELSIF fluxo2 <= 40 THEN verdeEscolhido := T#40S;
        ELSE verdeEscolhido := T#60S; END_IF;
    END_IF;
    noiteAnterior := noite;

    CASE etapa OF
        0, 3: duracao := verdeEscolhido;
        1, 4: duracao := T#4S;
        2, 5: duracao := T#2S;
        6: duracao := T#15S;
        7: duracao := T#5S;
    ELSE
        etapa := 0; duracao := T#20S;
    END_CASE;
    tempo := S_ODT(T_NO := T52, S := armaEtapa AND NOT noite,
                   TV := duracao, R := noite, BI := restante, Q := fimEtapa);
    IF NOT noite THEN
        IF fimEtapa THEN
            armaEtapa := FALSE;
            CASE etapa OF
                0: etapa := 1;
                1, 2: IF pedido THEN
                          etapa := 6; volta := 3; pedido := FALSE;
                      ELSE
                          IF etapa = 1 THEN etapa := 2;
                          ELSE
                              etapa := 3;
                              IF fluxo1 < 20 THEN verdeEscolhido := T#20S;
                              ELSIF fluxo1 <= 40 THEN verdeEscolhido := T#40S;
                              ELSE verdeEscolhido := T#60S; END_IF;
                          END_IF;
                      END_IF;
                3: etapa := 4;
                4, 5: IF pedido THEN
                          etapa := 6; volta := 0; pedido := FALSE;
                      ELSE
                          IF etapa = 4 THEN etapa := 5;
                          ELSE
                              etapa := 0;
                              IF fluxo2 < 20 THEN verdeEscolhido := T#20S;
                              ELSIF fluxo2 <= 40 THEN verdeEscolhido := T#40S;
                              ELSE verdeEscolhido := T#60S; END_IF;
                          END_IF;
                      END_IF;
                6: etapa := 7; piscaAceso := TRUE;
                7: etapa := volta;
                   IF etapa = 0 THEN
                       IF fluxo2 < 20 THEN verdeEscolhido := T#20S;
                       ELSIF fluxo2 <= 40 THEN verdeEscolhido := T#40S;
                       ELSE verdeEscolhido := T#60S; END_IF;
                   ELSE
                       IF fluxo1 < 20 THEN verdeEscolhido := T#20S;
                       ELSIF fluxo1 <= 40 THEN verdeEscolhido := T#40S;
                       ELSE verdeEscolhido := T#60S; END_IF;
                   END_IF;
            END_CASE;
        ELSIF NOT armaEtapa THEN
            armaEtapa := TRUE;
        END_IF;
    END_IF;

    tempo := S_ODT(T_NO := T53,
                   S := armaPisca AND (noite OR (etapa = 7)),
                   TV := T#500MS, R := FALSE, Q := fimPisca);
    IF noite OR (etapa = 7) THEN
        IF fimPisca THEN
            armaPisca := FALSE; piscaAceso := NOT piscaAceso;
        ELSIF NOT armaPisca THEN
            armaPisca := TRUE;
        END_IF;
    ELSE
        armaPisca := FALSE; piscaAceso := TRUE;
    END_IF;

    IF noite THEN
        IF piscaAceso THEN QB0 := B#16#92; // ambos amarelos; ped vermelho
        ELSE QB0 := B#16#80; END_IF;
    ELSE
        CASE etapa OF
            0: QB0 := B#16#8C;
            1: QB0 := B#16#94;
            2, 5: QB0 := B#16#A4;
            3: QB0 := B#16#A1;
            4: QB0 := B#16#A2;
            6: QB0 := B#16#64;
            7: IF piscaAceso THEN QB0 := B#16#A4;
               ELSE QB0 := B#16#24; END_IF;
        ELSE
            QB0 := B#16#A4;
        END_CASE;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB105.DB105();
END_ORGANIZATION_BLOCK
