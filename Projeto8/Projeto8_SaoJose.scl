// Requer FB107 do Projeto 7 ja compilado no mesmo S7 Program.
FUNCTION_BLOCK FB108
TITLE = 'Projetos 8 e 9 - 13 lampadas sem timer'
VAR_INPUT
    Maceio : BOOL;
END_VAR
VAR
    reg : FB107;
    fase : INT := 0;
    contador : INT := 0;
    clockAnterior : BOOL := FALSE;
END_VAR
VAR_TEMP
    resetReg : BOOL;
    pulsoReg : BOOL;
    dadoReg : BOOL;
 END_VAR
BEGIN
    resetReg := FALSE;
    pulsoReg := FALSE;
    dadoReg := FALSE;

     CASE fase OF
        0: // reset vermelho
            resetReg := TRUE;
            contador := 0;
            fase := 1;

        1: // semeia vermelho
            pulsoReg := TRUE;
            dadoReg := TRUE;
            contador := contador + 1;
            IF (Maceio AND (contador >= 6)) OR
               (NOT Maceio AND (contador >= 1)) THEN
                contador := 0;
                fase := 2;
            END_IF;

        2: // vermelho 30 s
            IF M10.0 AND NOT clockAnterior THEN
                contador := contador + 1;
                IF contador >= 300 THEN contador := 0; fase := 3; END_IF;
            END_IF;

        3, 4, 5, 6, 7, 8: // deslocamentos vermelhos de 1 s
            IF M10.0 AND NOT clockAnterior THEN
                contador := contador + 1;
                IF contador >= 10 THEN
                    contador := 0;
                    pulsoReg := TRUE;
                    IF (NOT Maceio AND (fase >= 7)) OR
                       (Maceio AND (fase >= 8)) THEN
                        fase := 9;
                    ELSE
                        fase := fase + 1;
                    END_IF;
                END_IF;
            END_IF;

        9: // amarelo 4 s
            IF M10.0 AND NOT clockAnterior THEN
                contador := contador + 1;
                IF contador >= 40 THEN contador := 0; fase := 10; END_IF;
            END_IF;

        10: // reset verde
            resetReg := TRUE;
            contador := 0;
            fase := 11;

        11: // semeia verde
            pulsoReg := TRUE;
            dadoReg := TRUE;
            contador := contador + 1;
            IF (Maceio AND (contador >= 6)) OR
               (NOT Maceio AND (contador >= 1)) THEN
                contador := 0;
                fase := 12;
            END_IF;

        12: // verde 30 s
            IF M10.0 AND NOT clockAnterior THEN
                contador := contador + 1;
                IF contador >= 300 THEN contador := 0; fase := 13; END_IF;
            END_IF;

        13, 14, 15, 16, 17, 18: // deslocamentos verdes de 1 s
            IF M10.0 AND NOT clockAnterior THEN
                contador := contador + 1;
                IF contador >= 10 THEN
                    contador := 0;
                    pulsoReg := TRUE;
                    IF (NOT Maceio AND (fase >= 17)) OR
                       (Maceio AND (fase >= 18)) THEN
                        fase := 19;
                    ELSE
                        fase := fase + 1;
                    END_IF;
                END_IF;
            END_IF;

        19: // amarelo 4 s
            IF M10.0 AND NOT clockAnterior THEN
                contador := contador + 1;
                IF contador >= 40 THEN contador := 0; fase := 0; END_IF;
            END_IF;

    ELSE
        fase := 0;
        contador := 0;
    END_CASE;

    reg(Forwardpulse := pulsoReg, Forwarddata := dadoReg,
        Backwardpulse := FALSE, Backwarddata := FALSE,
        Reset := resetReg);

    clockAnterior := M10.0;

    QB0 := B#16#00;
    QB1 := B#16#00;

    IF (fase >= 1) AND (fase <= 8) THEN
        QB0 := reg.Data AND B#16#3F;
    ELSIF (fase >= 11) AND (fase <= 18) THEN
        QB1 := reg.Data AND B#16#3F;
    ELSE
        QB0 := B#16#40;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB108.DB108(Maceio := FALSE);
END_ORGANIZATION_BLOCK
