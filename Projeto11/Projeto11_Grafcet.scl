FUNCTION_BLOCK FB111
TITLE = 'Passo sequenciador com entrada OU'
VAR_INPUT
    SetA : BOOL;
    SetB : BOOL;
    Reset : BOOL;
END_VAR
VAR_OUTPUT
    X : BOOL := FALSE;
END_VAR
BEGIN
    IF Reset THEN
        X := FALSE;
    ELSIF SetA OR SetB THEN
        X := TRUE;
    END_IF;
END_FUNCTION_BLOCK

FUNCTION_BLOCK FB211
TITLE = 'Projeto 11 - semaforo GRAFCET com OU e timer compartilhado'
VAR
    s0 : FB111; s1 : FB111; s2 : FB111;
    s3 : FB111; s4 : FB111; s5 : FB111;
    s6 : FB111; s7 : FB111;

    iniciado : BOOL := FALSE;
    pedido : BOOL := FALSE;
    anteriorBotao : BOOL := FALSE;
    voltaVia1 : BOOL := TRUE;

    timerIn : BOOL := FALSE;
    passoAnterior : INT := -1;
END_VAR
VAR_TEMP
    t01 : BOOL; t12 : BOOL; t16 : BOOL;
    t23 : BOOL; t26 : BOOL; t34 : BOOL;
    t45 : BOOL; t46 : BOOL; t50 : BOOL; t56 : BOOL;
    t67 : BOOL; t70 : BOOL; t73 : BOOL;

    passoAtual : INT;
    duracao : S5TIME;
    fimTempo : BOOL;
    resultado : S5TIME;
END_VAR
BEGIN
    IF I0.0 AND NOT anteriorBotao THEN pedido := TRUE; END_IF;
    anteriorBotao := I0.0;

    // O GRAFCET continua one-hot, mas um unico timer mede o passo ativo.
    passoAtual := -1;
    IF s0.X THEN passoAtual := 0;
    ELSIF s1.X THEN passoAtual := 1;
    ELSIF s2.X THEN passoAtual := 2;
    ELSIF s3.X THEN passoAtual := 3;
    ELSIF s4.X THEN passoAtual := 4;
    ELSIF s5.X THEN passoAtual := 5;
    ELSIF s6.X THEN passoAtual := 6;
    ELSIF s7.X THEN passoAtual := 7;
    END_IF;

    CASE passoAtual OF
        0, 3: duracao := T#30S;
        1, 4: duracao := T#4S;
        2, 5: duracao := T#2S;
        6: duracao := T#15S;
        7: duracao := T#5S;
    ELSE
        duracao := T#1S;
    END_CASE;

    IF passoAtual <> passoAnterior THEN
        timerIn := FALSE;
    END_IF;

    resultado := S_ODT(T_NO := T110,
                       S := timerIn AND (passoAtual >= 0),
                       TV := duracao, R := FALSE,
                       Q := fimTempo);

    IF (passoAtual >= 0) AND NOT timerIn THEN
        timerIn := TRUE;
    END_IF;

    passoAnterior := passoAtual;

    t01 := s0.X AND fimTempo;
    t12 := s1.X AND fimTempo AND NOT pedido;
    t16 := s1.X AND fimTempo AND pedido;
    t23 := s2.X AND fimTempo AND NOT pedido;
    t26 := s2.X AND fimTempo AND pedido;
    t34 := s3.X AND fimTempo;
    t45 := s4.X AND fimTempo AND NOT pedido;
    t46 := s4.X AND fimTempo AND pedido;
    t50 := s5.X AND fimTempo AND NOT pedido;
    t56 := s5.X AND fimTempo AND pedido;
    t67 := s6.X AND fimTempo;
    t70 := s7.X AND fimTempo AND NOT voltaVia1;
    t73 := s7.X AND fimTempo AND voltaVia1;

    IF t16 OR t26 THEN
        voltaVia1 := TRUE;
        pedido := FALSE;
    END_IF;

    IF t46 OR t56 THEN
        voltaVia1 := FALSE;
        pedido := FALSE;
    END_IF;

    // Passo 6 recebe duas ramificacoes OU, preservando o requisito do projeto.
    s0(SetA := NOT iniciado, SetB := t50 OR t70, Reset := t01);
    s1(SetA := t01, SetB := FALSE, Reset := t12 OR t16);
    s2(SetA := t12, SetB := FALSE, Reset := t23 OR t26);
    s3(SetA := t23, SetB := t73, Reset := t34);
    s4(SetA := t34, SetB := FALSE, Reset := t45 OR t46);
    s5(SetA := t45, SetB := FALSE, Reset := t50 OR t56);
    s6(SetA := t16 OR t26, SetB := t46 OR t56, Reset := t67);
    s7(SetA := t67, SetB := FALSE, Reset := t70 OR t73);
    iniciado := TRUE;

    Q0.0 := s3.X;
    Q0.1 := s4.X;
    Q0.2 := s0.X OR s1.X OR s2.X OR s5.X OR s6.X OR s7.X;
    Q0.3 := s0.X;
    Q0.4 := s1.X;
    Q0.5 := s2.X OR s3.X OR s4.X OR s5.X OR s6.X OR s7.X;
    Q0.6 := s6.X;
    Q0.7 := NOT s6.X;

    IF s7.X THEN
        Q0.7 := M10.5;
    END_IF;
END_FUNCTION_BLOCK

ORGANIZATION_BLOCK OB1
VAR_TEMP HEADER : ARRAY [1..20] OF BYTE; END_VAR
BEGIN
    FB211.DB211();
END_ORGANIZATION_BLOCK
